+/* Resolve a (possibly relative) playlist URI of length len against base_uri
+   (the playlist's directory, without trailing '/') and append it to out. */
+static char *append_resolved_uri(char *out, const char *uri, size_t len, const char *base_uri) {
+    const char *scheme = strstr(base_uri, "://");
+    const char *host_end = scheme ? strchr(scheme + 3, '/') : NULL;
+    size_t origin_len = host_end ? (size_t) (host_end - base_uri) : strlen(base_uri);
+    size_t scheme_len = strspn(uri, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+.-");
+    if (scheme_len > 0 && scheme_len < len && uri[scheme_len] == ':') {
+        /* absolute URI with a scheme, e.g. https:// or YouTube's mlhls:// */
+    } else if (len > 0 && uri[0] == '/') {
+        memcpy(out, base_uri, origin_len);
+        out += origin_len;
+    } else {
+        size_t base_len = strlen(base_uri);
+        memcpy(out, base_uri, base_len);
+        out += base_len;
+        *out++ = '/';
+    }
+    memcpy(out, uri, len);
+    return out + len;
+}
+
+/* Rewrite the relative URIs of an HLS playlist -- its URI lines and URI="..."
+   attributes -- into absolute ones under base_uri. YouTube's playlists only
+   use absolute URIs, but others (e.g. Jellyfin's) are relative to the
+   playlist's own location, which the media player, given the playlist from
+   http://localhost, would otherwise resolve against the server itself.
+   It returns a new playlist, WHICH MUST BE FREED AFTER USE */
+char *absolutize_playlist_uris(const char *playlist, const char *base_uri) {
+    size_t count = 1;
+    for (const char *p = playlist; *p; p++) {
+        if (*p == '\n' || !strncmp(p, "URI=\"", 5)) {
+            count++;
+        }
+    }
+    size_t len = strlen(playlist) + count * (strlen(base_uri) + 1);
+    char *new_playlist = (char *) malloc(len + 1);
+    if (!new_playlist) {
+        printf("Memory allocation failure (new_playlist)\n");
+        exit(1);
+    }
+    char *out = new_playlist;
+    const char *line = playlist;
+    while (*line) {
+        size_t line_len = strcspn(line, "\r\n");
+        if (line[0] == '#') {
+            const char *p = line;
+            const char *line_end = line + line_len;
+            const char *attr;
+            while ((attr = strstr(p, "URI=\"")) && attr < line_end) {
+                attr += 5;
+                const char *close = memchr(attr, '"', line_end - attr);
+                if (!close) {
+                    break;
+                }
+                memcpy(out, p, attr - p);
+                out += attr - p;
+                out = append_resolved_uri(out, attr, close - attr, base_uri);
+                p = close;
+            }
+            memcpy(out, p, line_end - p);
+            out += line_end - p;
+        } else if (line_len > 0) {
+            out = append_resolved_uri(out, line, line_len, base_uri);
+        }
+        line += line_len;
+        size_t eol_len = strspn(line, "\r\n");
+        memcpy(out, line, eol_len);
+        out += eol_len;
+        line += eol_len;
+    }
+    *out = '\0';
+    assert((size_t) (out - new_playlist) <= len);
+    return new_playlist;
+}
