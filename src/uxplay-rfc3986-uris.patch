+/* Resolve the playlist URI reference ref (len bytes) against base_uri, the
+   playlist's own URI, per RFC 3986, and append it to out. A reference that
+   cannot be resolved is kept as it is. */
+static void append_resolved_uri(GString *out, const char *ref, size_t len, const char *base_uri) {
+    char *reference = g_strndup(ref, len);
+    char *resolved = g_uri_resolve_relative(base_uri, reference, G_URI_FLAGS_ENCODED, NULL);
+    g_string_append(out, resolved ? resolved : reference);
